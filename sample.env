# ==============================================================================
# AI HRMS Copilot - Frontend Environment Configuration Template
# Copy this file to '.env.local' and adjust variables as needed.
# ==============================================================================

# The base URL of the FastAPI Backend API Service
# Local default: http://127.0.0.1:8000/api/v1
# Deployed default: https://cb-a2-hrms.onrender.com/api/v1
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"

# NextAuth Configuration
# Secret key used to encrypt the NextAuth JWT cookies.
# Generate a secure key using: openssl rand -base64 32
NEXTAUTH_SECRET="supersecretkey_please_change_in_production"

# The base URL of your Next.js application
# Local default: http://localhost:3000
# Deployed default: https://cb-a2-hrms-frntd.vercel.app
NEXTAUTH_URL="http://localhost:3000"
